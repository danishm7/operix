meta {
  name: post /api/auth/login
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
      "email": "danish@example.com",
      "password": "Test@123"
  }
}

tests {
  const response = res.getBody();
  
  bru.setEnvVar("accessToken", response.accessToken);
}

settings {
  encodeUrl: false
  timeout: 0
  forwardAuthorizationHeader: false
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "accessToken": ""
        }
      '''
    }
  }
}

