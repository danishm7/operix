meta {
  name: post /api/users
  type: http
  seq: 1
  tags: [
    Users
  ]
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: inherit
}

body:json {
  {
    "organizationId": "",
    "departmentId": "",
    "firstName": "",
    "lastName": "",
    "email": "",
    "password": ""
  }
}

settings {
  forwardAuthorizationHeader: false
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/users
    method: POST
    mode: json
    body:json: {
      {
        "organizationId": "",
        "departmentId": "",
        "firstName": "",
        "lastName": "",
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": "",
          "organizationId": "",
          "departmentId": "",
          "firstName": "",
          "lastName": "",
          "email": "",
          "isActive": false
        }
      '''
    }
  }
}

